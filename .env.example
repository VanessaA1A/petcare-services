## Copiar este archivo como .env y ajustar los valores antes de levantar docker compose.

# PostgreSQL
DB_NAME=PetCareBD
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Backend
JWT_SECRET=ChangeThisSecretKeyToATleast32Chars
SERVER_PORT=8080

# SMTP (opcional). Sin estos valores, el codigo OTP de verificacion se registra
# en el log del servidor y se devuelve en la respuesta de /api/auth/send-otp
# en vez de enviarse por correo real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# pgAdmin (opcional)
PGADMIN_EMAIL=admin@petcare.local
PGADMIN_PASSWORD=change-me
