## Copiar este archivo como .env y ajustar los valores antes de levantar docker compose.

# PostgreSQL
DB_NAME=PetCareBD
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Backend
JWT_SECRET=ChangeThisSecretKeyToATleast32Chars
SERVER_PORT=8080

# pgAdmin (opcional)
PGADMIN_EMAIL=admin@petcare.local
PGADMIN_PASSWORD=change-me
